{
  "name": "inferra-desktop",
  "version": "0.1.0",
  "description": "Inferra desktop shell (Tauri + Svelte)",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
